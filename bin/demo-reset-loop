#!/bin/bash
# Resets the demo account every DEMO_RESET_HOURS hours (default 24). Used by docker-compose.yml.
set -u
hours="${DEMO_RESET_HOURS:-24}"
sleep 60 # give the web container time to prepare the database on first boot
while true; do
  ./bin/rails demo:reset || echo "demo:reset failed, will retry next cycle"
  sleep "$((hours * 3600))"
done
