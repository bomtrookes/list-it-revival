  <% if !current_user %>

  <div class="pad home-card">
    <div class="container d-flex flex-column justify-content-around logo-wrap">

      <div class="logo-text">
        <div class="home-logos">
          <%= image_tag("https://res.cloudinary.com/mygreenhouses/image/upload/v1655547120/list-it/listit-icon_tldjfn.png", width: 120, height: 120) %>
        </div>

        <div class="home-logos">
          <%= image_tag("https://res.cloudinary.com/mygreenhouses/image/upload/v1655547120/list-it/listit-wordmark_dkt0ky.png", width: 250) %>
        </div>
        <h3>Create. Discover. Share.</h3>
      </div>

      <div class="welcome-card">
        <h1 class="h3 mb-3 font-weight-normal">Welcome!</h1>
        <p>List-it is a community of list lovers. From the most generic topics to the most niche interests. There's a list of anything you can think of!</p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
          <%= link_to "Log in", new_user_session_path, class: "btn btn-flat" %>
          <% if User.demo_user %>
            <%= button_to "Try the demo", demo_session_path, class: "btn btn-ghost", form_class: "d-inline" %>
          <% end %>
        </div>
        <p class="mt-3 mb-0"><small>Accounts are invite-only. Use the demo to look around.</small></p>
      </div>

    </div>
  </div>

  <% else %>

<div class="pad">
  <div class="row mt-2">
    <%# list card starts %>
    <% @lists.each do | list | %>
    <div class="col-md-4 mt-1">
        <div class="card p-2 mb-2">
          <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex flex-row align-items-center">
                  <div class="c-details">
                      <p class="mb-0">
                      <%= link_to format_username(list.user.username), list.user %>
                      </p>
                  </div>
              </div>
              <% if list.tags.present? %>
                <div class="tag">
                  <span><%= link_to format_tag(list.tags.first.to_s), tagged_path(tag: list.tags.first.name) %></span>
                </div>
              <% end %>
          </div>
          <%= link_to user_list_path(list.user, list)  do %>
            <div class="mt-2 card-link">
                <% if list.photo.attached? %>
                  <div class="mt-2 card-photo-title" style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url(<%= url_for(list.photo) %>)">
                    <%= list.title %>
                    <% if list.article == true %>
                      <span id="clip">
                        <i class="fa-solid fa-paperclip"></i>
                      </span>
                    <% end %>
                  </div>
                <% else %>
                  <div class="mt-2 card-title">
                  <%= list.title %>
                  </div>
                <% end %>
            </div>
          <% end %>
          <div class="d-flex justify-content-between align-items-end">
              <div class="d-flex flex-row align-items-center">
                  <div class="mt-2 c-details">
                    <span><em>Published: <%= time_ago_in_words(list.created_at) %> ago</em></span>
                  </div>
              </div>
                <div class="ms-2">
                  <span class="text1"><%= list.votes.size %> <span class="text2"><%=  "like".pluralize(list.votes.size) %></span></span>
                </div>
          </div>
        </div>
    </div>
    <% end %>
    <%# list card ends %>
  </div>
</div>

<% end %>
