<%= simple_form_for [current_user, @list] do |f| %>
  <%= f.input :title,
              placeholder: "Title",
              label: false %>
  <%= f.input :tag_list,
              label: false,
              placeholder: "Add your tags, separated by commas",
              :input_html => { :class => "css-class", :value => @list.tag_list.join(", ") } %>
  <%= f.input :photo, as: :file, input_html: photo_input_html, label: "Cover photo", required: false,
              hint: "Optional. Pick from your photos or take one; big photos are shrunk automatically." %>
  <%= f.input :article, as: :boolean, label: "Article", hint: "Lets you add a description and a photo to each item" %>
    <%# <em class="art-info">Want more from your lists? Add images and text to each list item!</em> %>
  <div class="form-actions">
    <%= f.button :submit, "Create", class:"btn-flat" %>
  </div>
<% end %>
