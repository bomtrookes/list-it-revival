<div class="container mt-5 mb-3">
  <div class="d-flex pt-2 justify-content-between align-items-center">
    <%= link_to :back, class:"back-button" do %>
      <i class="fa-solid fa-caret-left arrow"></i>
    <% end %>
    <h5><%= format_tag(@tag) %></h5>
  </div>
  <div class="row">
    <%# list card starts %>
    <% @lists.each do | list | %>
        <div class="col-md-6 col-lg-4">
          <%= render "lists/post_card", list: list %>
        </div>
    <% end %>
    <%# list card ends %>
  </div>
</div>
