<% if current_user %>
  <%
    items = [
      { label: "Feed",     icon: "fa-solid fa-house",            path: root_path,                       active: current_page?(root_path) },
      { label: "Discover", icon: "fa-solid fa-magnifying-glass", path: user_lists_path(current_user),   active: controller_name == "lists" && action_name == "index" },
      { label: "New",      icon: "fa-regular fa-square-plus",    path: new_user_list_path(current_user), active: controller_name == "lists" && action_name == "new" },
      { label: "Random",   icon: "fa-solid fa-dice",             path: random_list,                     active: false },
      { label: "Profile",  icon: "fa-solid fa-user",             path: user_path(current_user),         active: current_page?(user_path(current_user)) }
    ]
  %>
  <nav class="bottom-navbar" aria-label="Main">
    <ul>
      <% items.each do |item| %>
        <li>
          <%= link_to item[:path], class: ["bottom-nav-link", ("active" if item[:active])], "aria-current": (item[:active] ? "page" : nil) do %>
            <i class="<%= item[:icon] %>" aria-hidden="true"></i>
            <span class="bottom-nav-label"><%= item[:label] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
<% end %>
