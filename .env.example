# Copy to .env and fill in. Never commit .env.

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Database password used by the bundled Postgres container
POSTGRES_PASSWORD=

# Your admin login, created on first boot (change the password later from your Account page)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=bomtrookes

# The public hostname, used for links in emails and the share buttons
DOMAIN=list-it.example.com

# Port on the host that the app listens on
APP_PORT=3000

# Set both to false only if you are NOT serving the site over HTTPS
ASSUME_SSL=true
FORCE_SSL=true

# How often the demo account is reset, in hours
DEMO_RESET_HOURS=24

# Optional: store uploaded images on Cloudinary instead of the local "uploads" volume
# CLOUDINARY_URL=cloudinary://key:secret@cloud_name
