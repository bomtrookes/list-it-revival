{
  "name": "list-it",
  "private": true,
  "scripts": {
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --minify",
    "build:css": "sass ./app/assets/stylesheets/application.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps --silence-deprecation=import,global-builtin,color-functions"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@hotwired/stimulus": "^3.2.2",
    "@popperjs/core": "^2.11.8",
    "@rails/activestorage": "^8.1.0",
    "@rails/ujs": "^7.1.3",
    "bootstrap": "^5.3.3",
    "esbuild": "^0.25.0",
    "sass": "^1.80.0",
    "sortablejs": "^1.15.6"
  }
}
